! ScanTS Freq B3LYP/G def2-svp
# Number of processors
%pal nprocs 4 end
# Memory per core
%maxcore 1500
%geom
  Scan
  B 2 1 = 2.1, 1.1, 11  # Scanning bond distance from 2.1 Angstrom to 1.1 Angstrom in 11 steps. 
  end
end
